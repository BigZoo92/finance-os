# ── VCS & IDE ──────────────────────────────────
.git
.gitignore
.vscode

# ── Dependencies (re-installed in image) ──────
node_modules
**/node_modules
.pnpm-store

# ── Build artifacts (rebuilt in image) ─────────
apps/web/.output
coverage
dist
.tmp
.turbo
**/.next
# Panda runtime: generated in the image by the install (`prepare`).
**/styled-system/generated
**/__pycache__
**/*.py[cod]
.pytest_cache
**/.pytest_cache

# ── Secrets ────────────────────────────────────
.env
.env.*
!.env.example
!.env.prod.example
cookies.txt

# ── AI / agent tooling ────────────────────────
.agentic/
.agents/
.claude/
.codex/
.gitnexus/

# ── Documentation (not needed at runtime) ─────
docs/
DESIGN.md
*.md
!packages/*/README.md

# ── Infrastructure & scripts (not needed in images)
docker-compose*.yml
infra/dokploy
scripts/

# ── OS & logs ──────────────────────────────────
**/.DS_Store
pnpm-debug.log*
npm-debug.log*
yarn-error.log*
Thumbs.db
