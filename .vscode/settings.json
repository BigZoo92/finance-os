{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.eol": "\n",

  // Oxc toolchain: oxfmt formats, oxlint lints with the repo's type-aware
  // configuration (.oxfmtrc.json, .oxlintrc.json).
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "oxc.typeAware": true,
  "oxc.fixKind": "safe_fix",

  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "files.watcherExclude": {
    "./apps/web/**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "./apps/web/**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "./apps/web/**/routeTree.gen.ts": true
  }
}
