{
  "name": "@finance-os/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "bun src/migrate.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "db:seed:recurring-costs": "bun src/seeds/recurring-provider-cost.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "drizzle-kit": "0.31.11"
  }
}
